# The repo carries ONLY: code/tooling, docs, and the publishable website
# (docs/index.html + DZI pyramid — the pyramid's top level IS the full map).
# Everything else is local working state, regenerable or archival.

# secrets
.env

# environment
.venv/
__pycache__/
*.egg-info/

# regenerable-via-API working state (fetch/render caches only; the canonical
# map state — map_tiles, quadrants.sqlite, water.json, manifests — IS tracked
# since 2026-09 so the project can resume from a bare checkout)
cities/*/tile_cache/
cities/*/render_tiles/
cities/*/archive/
cities/api_budget.sqlite

# regenerable debug artifacts (keep the small hub/viewer html AND debug/infill:
# staged canvases + prompts for the windows in flight when gen access paused)
debug/renders/
debug/repair/
debug/map/
debug/tests/*.png
debug/tests/index.html

# raw web-app outputs
style_refs/
.claude/
